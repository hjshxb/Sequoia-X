# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# ── 增量同步并发进程数（默认：1 = 单进程串行）──
# baostock 对同一客户端的**并发登录有风控**：历史上「5221 只 × 8 进程」的重试风暴
# 直接换来「10001011 黑名单用户」，之后连 login 都要 1.5~2 分钟才超时
# （表现为 10002007 网络接收错误），且恢复期很长 —— 遇黑名单切勿反复重试。
# 因此默认保守串行；确需提速请先小批量验证（如 2），上限 32。
# 也可用命令行临时覆盖（不改配置）：python main.py --workers 4
# 取值范围 1~32；留空（SYNC_WORKERS=）等同默认 1。
SYNC_WORKERS=1

# ── 股票静态信息（代码 → 名称 / 行业）本地缓存有效期，单位：天 ──
# 名称/行业几乎不变，却要在每次运行时为「行业过滤 / HTML 报告 / 飞书推送」
# 三处各准备一份 —— 旧实现为此要多一次 baostock login + 一次
# query_stock_industry() 全市场请求。现在落盘到 DB_PATH 的 stock_meta 表：
#   · 命中缓存（TTL 内）⇒ 零网络请求；
#   · 超过了 TTL ⇒ 联网刷新一次并写回；
#   · 联网失败（登录被拒 / 查询报错）⇒ **降级用本地旧数据**并记 WARNING，
#     而不是返回空（空数据会让报告与卡片里的名称全部变成「—」）。
# 填 0 = 不信任缓存、每次都刷新；留空 = 默认 7 天。
# 想强制刷新一次：删掉库里的 stock_meta 表，或把此值设为 0 跑一次。
STOCK_META_TTL_DAYS=7

# 默认飞书 Webhook URL（必填，作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）
#
# ⚠️ 当前版本**不使用**按策略分流：每个交易日只推**一张汇总卡片**给默认 webhook，
#    卡片内部以「策略」为小节、小节内按板块分组。所以下面这些变量暂时都不生效。
#    仅在将来恢复「每个策略单独推送到自己群」时才需要配置。
#
# ⚠️ 若将来启用，注意路由判据是「该变量的值非空」，**不要保留占位符**！
#    哪怕值是 your-xxx-token 这种假地址，对应策略也会被路由到那个不存在的机器人，
#    推送静默失败（踩过这个坑）。不用时就注释掉。
# STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/<token>

# ══ 股票池精筛（全部可选，留空即该维度不参与过滤）══
#
# 执行顺序：精筛**前置于**策略执行 —— 先算出全市场合格股票池，
# 各策略只在池内选股（结果与「策略选完再过滤」完全一致，但读库量大幅下降）。
#
# 预筛采用分级执行以控制网络成本：
#   第 1 级（零边际成本）：成交额取自本地库、行业与筹码为全市场单次请求
#                          （且筹码按报告期缓存）→ 先把 5000+ 只收窄；
#   第 2 级（逐股联网）　：市值 / PE / PB / 换手率，只对第 1 级的残余股票请求。
# 若「成交额」「行业」「筹码」都没配置，第 1 级无法收窄，会直接对全市场拉取昂贵指标，
# 单线程约需 10 分钟以上（日志会给出 WARNING）。
#
# 注：RPS 策略是横截面指标（全市场涨幅百分位排名），其**排名仍在全市场范围内计算**，
#     不受预筛影响；预筛只决定最终结果里保留哪些股票。

# ── 1) 估值 ──
# 流通市值区间，单位：亿元。例：50 ~ 500 亿流通盘
MIN_MARKET_CAP=
MAX_MARKET_CAP=
# 市盈率(TTM)区间。亏损股市盈率为负，设 MIN_PE=0 可排除亏损股。例：0 ~ 60 倍
MIN_PE=
MAX_PE=
# 市净率区间。例：1 ~ 8 倍
MIN_PB=
MAX_PB=

# ── 2) 流动性 ──
# 成交额下限，单位：亿元（取自本地库，无网络开销）
MIN_TURNOVER=

# ── 3) 技术面 ──
# 换手率区间，单位：%（可用于排除过热或过于冷门的票）
MIN_TURN=
MAX_TURN=

# ── 4) 行业 ──
# 逗号分隔的关键词，按子串匹配行业名（不必写全称）
# INCLUDE 非空时只保留命中任一关键词的；EXCLUDE 命中的一律排除
# 例：INCLUDE_INDUSTRIES=电子,软件,医药
#     EXCLUDE_INDUSTRIES=房地产,银行
INCLUDE_INDUSTRIES=
EXCLUDE_INDUSTRIES=

# ── 5) 筹码集中度：前十大流通股东合计持股占流通股比例（%）──
# 口径：该股前 10 名流通股东各自「占流通股比例」之和。数值越高 = 筹码越集中。
# 数据源：东财「十大流通股东」全市场接口（非逐股），按报告期落盘缓存到
#         HOLDER_CACHE_DIR（默认 data/cache，已 gitignore），一年仅更新 4 次，
#         命中缓存后零网络开销；首次拉取约 5 秒。
#
# ⚠️ 阈值参考（2026-06-30 全市场 4994 只实测分布）：
#     中位数 ≈ 47%，均值 ≈ 47%
#     >=30% -> 保留 80% 的股票（几乎不筛）
#     >=40% -> 保留 64%      >=50% -> 保留 44%
#     >=60% -> 保留 26%      >=70% -> 保留 13%
#     分位数：p10=22  p25=33  p50=47  p75=62  p90=72
#   👉 想要「筹码集中」的收敛力，建议 MIN 取 50~60；填 30 基本等于不筛。
# MAX 用于排除流通盘被锁死、实际可交易筹码过少的个股。
MIN_TOP10_FREE_HOLDING=
MAX_TOP10_FREE_HOLDING=
# 指定股东数据报告期（YYYY-MM-DD 或 YYYYMMDD）。留空 = 自动取最新已披露季末，
# 若最新一期尚未披露会自动回退到上一期。
HOLDER_REPORT_DATE=
# 股东数据缓存目录（相对仓库根目录）
HOLDER_CACHE_DIR=data/cache

# ── 本地 HTML 报告（按策略分块展示选股结果：代码 / 名称 / 板块 / 行业）──
# 跑完策略后自动生成，路径为 <REPORT_DIR>/stock_report_<日期>.html
# 每个策略卡片内部按上市板块分组（主板 → 创业板 → 科创板 → 北交所 → 其他），
# 组内按代码升序；页内搜索覆盖 代码/名称/行业/板块。
# 精筛启用时，报告里的 市值 / 换手率 / PE(TTM) 三列复用精筛已拉取的指标，
# 不产生额外网络请求。
REPORT_ENABLED=true
REPORT_DIR=reports
